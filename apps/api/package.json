{
  "name": "@grumphya/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start:dev": "tsx watch src/main.ts",
    "provision-admin": "tsx src/admin-dashboard/provision-admin.ts",
    "change-admin-password": "tsx src/admin-dashboard/provision-admin.ts --change-password",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "benchmark:evaluator": "tsx scripts/evaluator-benchmark.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --ignoreConfig --noEmit --target ES2022 --module NodeNext --moduleResolution NodeNext --strict --esModuleInterop --skipLibCheck scripts/evaluator-benchmark.ts scripts/prepare-test-database.ts",
    "lint": "eslint src scripts --max-warnings=0"
  },
  "dependencies": {
    "@nestjs/common": "^12.1.3",
    "@nestjs/core": "^12.1.3",
    "@nestjs/platform-express": "^12.1.3",
    "bcryptjs": "3.0.3",
    "multer": "^2.4.0",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/multer": "^2.3.0",
    "@types/node": "^24.5.2",
    "@types/pg": "^8.15.5",
    "eslint": "^10.0.1",
    "tsx": "^4.20.5",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^4.1.12"
  }
}
