{
  "name": "@grumphya/prototype-desarrollo-seguro-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prebuild": "pnpm --filter @grumphya/prototype-desarrollo-seguro-core build && pnpm --filter @grumphya/prototype-desarrollo-seguro-persistence build",
    "build": "tsc -p tsconfig.json",
    "pretest": "pnpm --filter @grumphya/prototype-desarrollo-seguro-core build && pnpm --filter @grumphya/prototype-desarrollo-seguro-persistence build",
    "test": "vitest run src scripts",
    "pretypecheck": "pnpm --filter @grumphya/prototype-desarrollo-seguro-core build && pnpm --filter @grumphya/prototype-desarrollo-seguro-persistence build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src scripts --max-warnings=0"
  },
  "dependencies": {
    "@grumphya/prototype-desarrollo-seguro-core": "workspace:*",
    "@grumphya/prototype-desarrollo-seguro-persistence": "workspace:*",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/pg": "^8.15.5",
    "eslint": "^10.0.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^4.1.12"
  }
}
