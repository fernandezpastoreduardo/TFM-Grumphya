{$DOMAIN} {
	encode zstd gzip
	tls {
		protocols tls1.2 tls1.3
	}
	@directAudit path /api/audit /api/audit/*
	handle @directAudit {
		header Content-Type application/json
		respond `{"code":"resource_not_allowed","message":"Recurso no permitido."}` 404
	}
	@audit path /audit/infrastructure /audit/deployment /audit/dependencies /audit/auth /audit/quality /audit/privacy /audit/ai
	handle @audit {
		@auditQuery expression `{http.request.uri.query} != ""`
		header @auditQuery Content-Type application/json
		respond @auditQuery `{"code":"invalid_request","message":"No se permiten parámetros de consulta."}` 400
		@auditMethod not method GET
		header @auditMethod Content-Type application/json
		respond @auditMethod `{"code":"method_not_allowed","message":"Solo se permite GET."}` 405
		rewrite * /api{uri}
		reverse_proxy https://api:3000 {
			transport http {
				tls_trust_pool file /run/secrets/internal_tls_ca.crt
			}
		}
	}
	@unknownAudit path /audit /audit/*
	handle @unknownAudit {
		header Content-Type application/json
		respond `{"code":"resource_not_allowed","message":"Recurso no permitido."}` 404
	}
	@api path /api/*
	handle @api {
		reverse_proxy https://api:3000 {
			transport http {
				tls_trust_pool file /run/secrets/internal_tls_ca.crt
			}
		}
	}
	handle {
		reverse_proxy https://web:8443 {
			transport http {
				tls_trust_pool file /run/secrets/internal_tls_ca.crt
			}
		}
	}
	header {
		-Server
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Cross-Origin-Opener-Policy "same-origin"
		Cross-Origin-Embedder-Policy "require-corp"
		Cross-Origin-Resource-Policy "same-origin"
		Permissions-Policy "camera=(), microphone=(self), geolocation=(), on-device-speech-recognition=(self)"
		Content-Security-Policy "base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'"
		Reporting-Endpoints "grumphya-csp=\"https://{$DOMAIN}/api/csp-reports\""
		Content-Security-Policy-Report-Only "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self' 'sha256-suebgenoyDvF0MseSMQjhvmvvc00cXYsKyXaeDanRCI='; style-src 'self' 'unsafe-inline'; img-src 'self' blob:; font-src 'self'; connect-src 'self'; report-to grumphya-csp; report-uri /api/csp-reports"
	}
}
www.{$DOMAIN} {
	header -Server
	redir https://{$DOMAIN}{uri} permanent
}

import /etc/caddy/sites-enabled/*.caddy
